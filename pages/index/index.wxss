.hero {
  background: linear-gradient(135deg, #4b6bfb, #7d92ff);
  border-radius: 28rpx;
  padding: 40rpx 36rpx 32rpx;
  color: #fff;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(75, 107, 251, 0.25);
}

.hero-title {
  font-size: 42rpx;
  font-weight: 700;
}

.hero-sub {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.hero-stats {
  display: flex;
  margin-top: 32rpx;
}

.hero-stat {
  flex: 1;
  text-align: center;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 18rpx;
  padding: 18rpx 0;
  margin-right: 16rpx;
}

.hero-stat:last-child {
  margin-right: 0;
}

.hero-stat .n {
  font-size: 40rpx;
  font-weight: 700;
}

.hero-stat .l {
  font-size: 22rpx;
  opacity: 0.9;
}

.voice-banner {
  background: var(--warn-soft);
  border: 2rpx solid #f3dfb8;
  border-radius: 20rpx;
  padding: 22rpx 26rpx;
  margin-bottom: 24rpx;
}

.voice-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #c97a15;
}

.voice-sub {
  display: block;
  font-size: 24rpx;
  color: #b07a2e;
  margin-top: 6rpx;
}

.quick {
  display: flex;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.quick-item {
  flex: 1;
  background: #fff;
  border-radius: 22rpx;
  padding: 26rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(31, 39, 51, 0.05);
}

.quick-item:active {
  background: #f7f9ff;
}

.qi-icon {
  font-size: 44rpx;
}

.qi-text {
  font-size: 26rpx;
  margin-top: 8rpx;
  color: var(--ink);
}

/* ---- 听写入口 ---- */
.dict-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #12897b, #2bb39c);
  border-radius: 24rpx;
  padding: 30rpx 30rpx;
  margin-bottom: 32rpx;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(18, 137, 123, 0.25);
}

.dict-banner:active {
  opacity: 0.92;
}

.db-title {
  font-size: 34rpx;
  font-weight: 700;
}

.db-sub {
  font-size: 23rpx;
  opacity: 0.9;
  margin-top: 8rpx;
  line-height: 1.4;
}

.db-left {
  flex: 1;
  padding-right: 20rpx;
}

.db-go {
  font-size: 26rpx;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  white-space: nowrap;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink2);
  margin: 0 4rpx 18rpx;
}

.unit-card {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 22rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 39, 51, 0.05);
}

.unit-card:active {
  background: #fafbff;
}

.unit-left {
  width: 116rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.unit-no {
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  line-height: 1.4;
  padding: 0 6rpx;
}

.unit-main {
  flex: 1;
  padding: 24rpx 26rpx;
  min-width: 0;
}

.unit-en {
  font-size: 30rpx;
  font-weight: 600;
  font-family: Georgia, serif;
  line-height: 1.4;
}

.unit-cn {
  font-size: 24rpx;
  color: var(--ink2);
  margin-top: 6rpx;
}

.unit-meta {
  display: flex;
  gap: 24rpx;
  margin-top: 14rpx;
}

.unit-meta .err {
  color: var(--bad);
}

.foot-tip {
  text-align: center;
  font-size: 24rpx;
  color: var(--ink2);
  margin-top: 30rpx;
}

.foot-tip .hot {
  color: var(--primary);
  font-weight: 700;
  font-family: Georgia, serif;
}
