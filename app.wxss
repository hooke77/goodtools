/* ================= 全局设计系统 ================= */
page {
  --primary: #4b6bfb;
  --primary-soft: #eef2ff;
  --primary-deep: #3350d9;
  --ok: #22b573;
  --ok-soft: #e9f8f1;
  --warn: #ff9f43;
  --warn-soft: #fff7e8;
  --bad: #ef4b6b;
  --bad-soft: #fdeef2;
  --ink: #1f2733;
  --ink2: #7a8398;
  --line: #e9ecf5;
  --bg: #f4f6fb;
  --card: #ffffff;

  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 180rpx;
  box-sizing: border-box;
}

/* ---- 卡片 ---- */
.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 39, 51, 0.05);
}

.card-tight {
  padding: 20rpx 24rpx;
}

/* ---- 文字 ---- */
.h1 {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
}

.h2 {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
}

.h3 {
  font-size: 30rpx;
  font-weight: 600;
}

.sub {
  font-size: 26rpx;
  color: var(--ink2);
}

.tiny {
  font-size: 24rpx;
  color: var(--ink2);
}

.en {
  font-family: Georgia, "Times New Roman", serif;
  letter-spacing: 0.5rpx;
}

/* ---- 按钮 ---- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 36rpx;
  border: none;
  line-height: 1.2;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--primary);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(75, 107, 251, 0.28);
}

.btn-primary:active {
  background: var(--primary-deep);
}

.btn-ghost {
  background: #fff;
  color: var(--primary);
  border: 2rpx solid #d9e0ff;
}

.btn-ghost:active {
  background: var(--primary-soft);
}

.btn-gray {
  background: #f1f3f9;
  color: var(--ink2);
}

.btn-danger {
  background: var(--bad-soft);
  color: var(--bad);
}

.btn-lg {
  font-size: 34rpx;
  padding: 30rpx 40rpx;
}

.btn-sm {
  font-size: 26rpx;
  padding: 14rpx 26rpx;
}

.btn-block {
  width: 100%;
}

.btn-disabled {
  opacity: 0.5;
}

/* ---- 标签 ---- */
.chip {
  display: inline-flex;
  align-items: center;
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary);
  margin-right: 12rpx;
}

.chip-ok {
  background: var(--ok-soft);
  color: var(--ok);
}

.chip-warn {
  background: var(--warn-soft);
  color: #c97a15;
}

.chip-bad {
  background: var(--bad-soft);
  color: var(--bad);
}

/* 识别通道标签（自评 / 自动评分） */
.mode-chip {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 500;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  margin-left: 12rpx;
  vertical-align: middle;
  background: var(--warn-soft);
  color: #c97a15;
}

.mode-chip.cloud,
.mode-chip.plugin {
  background: var(--ok-soft);
  color: var(--ok);
}

/* ---- 布局 ---- */
.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.grow {
  flex: 1;
  min-width: 0;
}

.mt8 { margin-top: 8rpx; }
.mt16 { margin-top: 16rpx; }
.mt24 { margin-top: 24rpx; }
.mt32 { margin-top: 32rpx; }
.mb16 { margin-bottom: 16rpx; }

/* ---- 进度条 ---- */
.bar {
  height: 14rpx;
  background: #eceffa;
  border-radius: 999rpx;
  overflow: hidden;
}

.bar-in {
  height: 100%;
  border-radius: 999rpx;
  background: var(--primary);
  transition: width 0.3s;
}

.bar-in.is-ok { background: var(--ok); }
.bar-in.is-warn { background: var(--warn); }
.bar-in.is-bad { background: var(--bad); }

/* ---- 空状态 ---- */
.empty {
  text-align: center;
  padding: 80rpx 40rpx;
  color: var(--ink2);
  font-size: 27rpx;
}

.empty-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: 16rpx;
}

/* ---- 底部固定操作条 ---- */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -4rpx 24rpx rgba(31, 39, 51, 0.06);
  display: flex;
  gap: 20rpx;
}

/* ---- 分隔线 ---- */
.divider {
  height: 1rpx;
  background: var(--line);
  margin: 20rpx 0;
}

/* ================= 自评模式专用组件 ================= */

/* ---- 读前易错词预告（朗读页） ---- */
.watch-box {
  background: var(--primary-soft);
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
}

.watch-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary-deep);
  margin-bottom: 6rpx;
}

.watch-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 12rpx;
}

.watch-word {
  flex: none;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--primary-deep);
  background: #fff;
  border-radius: 10rpx;
  padding: 4rpx 14rpx;
}

.watch-tip {
  flex: 1;
  font-size: 25rpx;
  color: #4a5570;
  line-height: 1.5;
}

/* ---- 节奏比对卡（朗读页 + 单词页） ---- */
.pace-box {
  margin-top: 22rpx;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  background: var(--ok-soft);
}

.pace-box.fast {
  background: var(--warn-soft);
}

.pace-box.slow {
  background: var(--primary-soft);
}

.pace-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.pace-label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ok);
}

.pace-box.fast .pace-label {
  color: #b06a12;
}

.pace-box.slow .pace-label {
  color: var(--primary-deep);
}

.pace-ratio {
  font-size: 24rpx;
  color: var(--ink2);
}

.pace-tip {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #4a5570;
  line-height: 1.55;
}
